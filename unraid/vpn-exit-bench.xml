<?xml version="1.0"?>
<Container version="2">
    <Name>VPN Exit Bench</Name>
    <Repository>ghcr.io/mlo-tek/vpn-exit-bench:latest</Repository>
    <Registry>https://github.com/mlo-Tek/VPN-Exit-Bench/pkgs/container/vpn-exit-bench</Registry>
    <Network>bridge</Network>
    <WebUI>http://[IP]:[PORT:8787]/</WebUI>
    <Privileged>false</Privileged>
    <Project>https://github.com/mlo-Tek/VPN-Exit-Bench</Project>
    <Support>https://github.com/mlo-Tek/VPN-Exit-Bench/issues</Support>
    <Overview>Unraid web UI for benchmarking WireGuard and OpenVPN exit locations in isolated short-lived Docker workers without changing the Unraid host route.</Overview>
    <Beta>True</Beta>
    <Category>Network: Tools:</Category>
    <TemplateURL>https://raw.githubusercontent.com/mlo-Tek/VPN-Exit-Bench/main/unraid/vpn-exit-bench.xml</TemplateURL>
    <Maintainer>
        <WebPage>https://github.com/mlo-Tek</WebPage>
    </Maintainer>
    <Changes>### 2026-09-01

Initial Unraid XML template.</Changes>
    <Config Name="Web UI Port" Target="8787" Default="8787" Mode="tcp" Description="VPN Exit Bench Web UI" Type="Port" Display="always" Required="true" Mask="false">8787</Config>
    <Config Name="Appdata" Target="/config" Default="/mnt/cache/appdata/vpn-exit-bench" Mode="rw" Description="Persistent database and VPN config storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/appdata/vpn-exit-bench</Config>
    <Config Name="Docker Socket" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="rw" Description="Required to launch isolated VPN test workers" Type="Path" Display="advanced" Required="true" Mask="false">/var/run/docker.sock</Config>
    <Config Name="Worker Image" Target="WORKER_IMAGE" Default="ghcr.io/mlo-tek/vpn-exit-bench:latest" Description="Docker image used for short-lived VPN test workers" Type="Variable" Display="advanced" Required="true" Mask="false">ghcr.io/mlo-tek/vpn-exit-bench:latest</Config>
    <Config Name="Host VPN Config Directory" Target="HOST_CONFIG_DIR" Default="/mnt/cache/appdata/vpn-exit-bench/vpns" Description="Host path containing provider folders and VPN config files" Type="Variable" Display="advanced" Required="true" Mask="false">/mnt/cache/appdata/vpn-exit-bench/vpns</Config>
    <Config Name="Download Test Size MB" Target="DOWNLOAD_MB" Default="100" Description="Amount downloaded per throughput test in MB" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
</Container>
